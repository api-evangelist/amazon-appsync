{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon AppSync Api Keys Tags API",
    "version": "2017-07-25"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon AppSync List Tags For Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://appsync.us-east-1.amazonaws.com/v1/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists the tags for a resource."
        },
        {
          "info": {
            "name": "Amazon AppSync Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://appsync.us-east-1.amazonaws.com/v1/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Tags a resource with user-supplied tags."
        },
        {
          "info": {
            "name": "Amazon AppSync Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://appsync.us-east-1.amazonaws.com/v1/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path"
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Untags a resource."
        }
      ]
    }
  ],
  "bundled": true
}